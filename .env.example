# ---------------------------------------------------------------------------
# United Rails e.V.: Beispielkonfiguration
#
# Diese Datei enthält NUR leere Platzhalter und gehört ins Repository.
# Die echten Werte stehen in .env und werden niemals eingecheckt.
#
# Kopieren:  cp .env.example .env
# ---------------------------------------------------------------------------

# --- Seite -----------------------------------------------------------------
# Öffentliche Basis-URL. Die Domain kann sich ändern, daher steht sie nur hier.
SITE_URL=https://unlimited-rails.de

# --- Datenbank -------------------------------------------------------------
# PostgreSQL-Verbindung, z. B. postgresql://benutzer:passwort@localhost:5432/united_rails
DATABASE_URL=

# --- Discord OAuth ---------------------------------------------------------
# Meldet Teammitglieder an. Discord-Rollen vergeben KEINE Rechte auf der
# Webseite. Die Rechte stehen ausschließlich in der Datenbank.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
# Zufälliger Wert zum Signieren der Sitzungen, z. B. `openssl rand -base64 32`
AUTH_SECRET=

# --- Externe Ziele ---------------------------------------------------------
# Leere Werte blenden den jeweiligen Link im gesamten Auftritt aus.
DISCORD_URL=
CURSEFORGE_URL=
MODRINTH_URL=
YOUTUBE_URL=https://www.youtube.com/@United-Rails
GALLERY_URL=
# Adresse zum Verbinden, z. B. play.beispiel.de
SERVER_URL=
HOSTER_URL=

# --- Dateiablage -----------------------------------------------------------
# local = Dateien auf dem Server, s3 = S3-kompatibler Speicher.
# Der endgültige Anbieter steht noch nicht fest.
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage
# Öffentliche Basis-URL der abgelegten Dateien (nur bei externem Speicher nötig)
STORAGE_PUBLIC_BASE_URL=
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- Create Railway Navigator ----------------------------------------------
# TODO: Die offizielle CRN-Dokumentation liegt noch nicht vor.
# Basis-URL und Schlüssel bleiben leer, bis sie da ist. Es werden keine
# Endpunkte, Formate oder Anmeldeverfahren geraten.
CRN_API_BASE_URL=
CRN_API_KEY=

# --- Serverstatus ----------------------------------------------------------
# TODO: Quelle für den Live-Status steht noch nicht fest. Solange leer, zeigt
# die Seite ausdrücklich „keine Daten" statt erfundener Spielerzahlen.
SERVER_STATUS_API_URL=

# --- Uploads ---------------------------------------------------------------
UPLOAD_MAX_FILE_SIZE_MB=8
UPLOAD_MAX_FILES_PER_APPLICATION=8
