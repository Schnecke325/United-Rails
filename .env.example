# ---------------------------------------------------------------------------
# United Rails e.V.: Beispielkonfiguration
#
# Diese Datei enthält NUR leere Platzhalter und gehört ins Repository.
# Die echten Werte stehen in .env und werden niemals eingecheckt.
#
# Kopieren:  cp .env.example .env && php artisan key:generate
# ---------------------------------------------------------------------------

# --- Anwendung -------------------------------------------------------------
APP_NAME="United Rails e.V."
APP_ENV=production
# Wird von `php artisan key:generate` gesetzt. Niemals einchecken.
APP_KEY=
APP_DEBUG=false
# Öffentliche Basis-URL. Die Domain kann sich ändern, daher steht sie nur hier.
APP_URL=https://unlimited-rails.de
APP_LOCALE=de
APP_TIMEZONE=Europe/Berlin

# --- Logs und Wartung ------------------------------------------------------
# Auf dem Webspace ist der Platz knapp. daily rotiert und hält nur 14 Tage.
LOG_CHANNEL=daily
LOG_LEVEL=warning

# --- Sitzungen und Cache ---------------------------------------------------
# Bewusst auf der Platte des Webspace, nicht in der Datenbank. Die Datenbank
# ist extern, jede zusätzliche Abfrage kostet eine Runde über das Netz.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=database

# --- Datenbank (extern) ----------------------------------------------------
# Läuft nicht auf dem Webspace. Es steht bewusst kein Anbieter im Code.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# Pfad zum CA-Zertifikat des Anbieters, falls er eines verlangt.
DB_SSL_CA=
# Nur abschalten, wenn der Anbieter kein prüfbares Zertifikat liefert.
DB_SSL_VERIFY=true

# --- Dateiablage (extern, S3-kompatibel) -----------------------------------
# local nur für die Entwicklung. Im Betrieb s3, damit Galeriebilder,
# Kartenkacheln und Modpack-Archive nicht auf dem Webspace landen.
# Der Anbieter steht noch nicht fest und gehört auch nicht in den Code.
FILESYSTEM_DISK=local
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Öffentliche Basis-URL der Dateien, etwa eine eigene Domain vor dem Bucket.
STORAGE_PUBLIC_BASE_URL=
# true, wenn der Anbieter den Bucket im Pfad statt in der Subdomain erwartet.
STORAGE_PATH_STYLE=false
STORAGE_VISIBILITY=private

# --- Discord OAuth ---------------------------------------------------------
# Meldet Teammitglieder an. Discord-Rollen vergeben KEINE Rechte auf der
# Webseite. Die Rechte stehen ausschließlich in der Datenbank.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=

# --- Externe Ziele ---------------------------------------------------------
# Leere Werte blenden den jeweiligen Link im gesamten Auftritt aus.
DISCORD_URL=
CURSEFORGE_URL=
MODRINTH_URL=
YOUTUBE_URL=https://www.youtube.com/@United-Rails
GALLERY_URL=
# Adresse zum Verbinden, z. B. play.beispiel.de
SERVER_URL=
HOSTER_URL=

# --- Create Railway Navigator ----------------------------------------------
# TODO: Die offizielle CRN-Dokumentation liegt noch nicht vor. Basis-URL und
# Authentifizierung bleiben leer, bis sie da ist.
CRN_API_BASE_URL=
CRN_API_KEY=

# --- Serverstatus ----------------------------------------------------------
# TODO: Noch keine Datenquelle festgelegt. Solange leer, zeigt die Seite
# ausdrücklich "keine Daten" statt erfundener Spielerzahlen.
SERVER_STATUS_API_URL=
SERVER_STATUS_CACHE_SECONDS=60

# --- Uploads ---------------------------------------------------------------
UPLOAD_MAX_FILE_SIZE_MB=8
UPLOAD_MAX_FILES_PER_APPLICATION=8

# --- Mail ------------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
